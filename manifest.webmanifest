{"name":"Kobi Org","short_name":"Org","description":"As escalas, o programa das reuniões, a reunião pública, o testemunho público, os territórios e a pauta dos anciãos, num aplicativo que mora no seu aparelho. Gratuito, sem conta e sem nuvem — e funciona sem internet depois da primeira abertura.","start_url":"./","display":"standalone","background_color":"#ffffff","theme_color":"#7048e8","lang":"pt-BR","scope":"./","id":"org","categories":["productivity","utilities"],"orientation":"portrait","icons":[{"src":"./icons/kobi-org-192.png","sizes":"192x192","type":"image/png","purpose":"any"},{"src":"./icons/kobi-org-512.png","sizes":"512x512","type":"image/png","purpose":"any"},{"src":"./icons/kobi-org-maskable-192.png","sizes":"192x192","type":"image/png","purpose":"maskable"},{"src":"./icons/kobi-org-maskable-512.png","sizes":"512x512","type":"image/png","purpose":"maskable"}]}
